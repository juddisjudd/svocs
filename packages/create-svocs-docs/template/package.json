{
	"name": "__PACKAGE_NAME__",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/search/postbuild.mjs && node scripts/og/generate.mjs",
		"search:index": "pagefind --site build",
		"preview": "vite preview",
		"dev:deno": "deno task dev",
		"build:deno": "deno task build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@takumi-rs/core": "^2.14.0",
		"@types/node": "^24.19.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"katex": "^0.16.47",
		"mdsvex": "^0.12.8",
		"mermaid": "^12.1.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex-svelte": "^1.2.0",
		"rehype-slug": "^6.0.0",
		"remark-math": "^3.0.1",
		"sitemap": "^9.0.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"github-slugger": "^2.0.0",
		"unist-util-visit": "^5.1.0"
	}
}
